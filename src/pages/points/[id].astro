---
import Layout from '../../layouts/Layout.astro'
import StatusBadge from '../../components/StatusBadge.astro'
import { observationPoints, getObservationPoint } from '../../features/observation-points/fixtures'
export function getStaticPaths() {
  return observationPoints.map((point) => ({ params: { id: point.id }, props: { point } }))
}
const { point: passedPoint } = Astro.props as { point: (typeof observationPoints)[number] }
const point = passedPoint ?? getObservationPoint(Astro.params.id ?? '')
---

<Layout title={`${point.name} · CALUZ`}>
  <div class="measure py-16 pb-32">
    <a class="mb-16 inline-block text-subtle no-underline hover:text-accent" href="/#map">← Volver a la red</a>
    <header
      class="flex items-end justify-between gap-8 border-b border-border pb-16 max-md:flex-col max-md:items-start"
    >
      <div>
        <p class="eyebrow">{point.region} · Punto de observación</p><h1>{point.name}</h1><p class="hero-copy">
          {point.everydayMeaning}
        </p>
      </div><StatusBadge status={point.status} />
    </header>
    <div class="mt-8 grid grid-cols-2 gap-4 max-md:grid-cols-1">
      <article class="card">
        <p class="eyebrow">En términos cotidianos</p><h2>¿Qué nos dice este punto?</h2><p>
          {point.context}
        </p>
      </article>
      <article class="card">
        <p class="eyebrow">Contexto</p><h2>Lee la fecha junto al estado.</h2><p>
          {
            point.updatedAt
              ? `El fixture actual se actualizó el ${point.updatedAt}. Es una lectura resumida, no una señal en tiempo real.`
              : 'Aún no hay una observación disponible. Los indicadores aparecerán cuando exista una lectura validada.'
          }
        </p>
      </article>
    </div>
    <section class="py-20">
      <div class="mb-8 flex max-w-none justify-between gap-12 max-md:flex-col">
        <div><p class="eyebrow">Indicadores resumidos</p><h2>¿Qué se observó?</h2></div><p class="section-lede">
          Los valores técnicos aparecen después de la interpretación. Cada valor necesita su unidad, fecha y significado
          en lenguaje claro.
        </p>
      </div>{
        point.indicators.length ? (
          <div class="grid grid-cols-2 gap-4 max-md:grid-cols-1">
            {point.indicators.map((indicator) => (
              <article class="card grid gap-2">
                <p class="m-0 text-muted">{indicator.label}</p>
                <strong class="text-3xl">{indicator.value}</strong>
                <span class="text-muted">{indicator.meaning}</span>
              </article>
            ))}
          </div>
        ) : (
          <div class="card text-subtle">
            <>
              <strong>Aún no hay datos disponibles</strong>
              <p>Este punto pertenece a la red, pero todavía no hay una lectura validada para mostrar.</p>
            </>
          </div>
        )
      }
    </section>
    <section class="py-20">
      <p class="eyebrow">Lectura adicional</p><h2>La capa técnica viene después.</h2><p
        class="max-w-xl leading-relaxed text-subtle"
      >
        Las series, métodos, archivos y una vista completa de datos se conectarán aquí cuando se confirmen el contrato
        de la API de Django y los requisitos de infraestructura.
      </p><a class="text-link" href="/#map">Comparar otro punto →</a>
    </section>
  </div>
</Layout>
