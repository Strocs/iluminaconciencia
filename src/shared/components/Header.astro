---
import { Image } from 'astro:assets'
import logo from '@assets/iluminaconciencia-logo.png'
---

<header
  class="fixed top-0 right-0 left-0 z-100 container mx-auto flex min-h-20 items-center justify-between gap-8 px-8 max-md:flex-col max-md:items-start"
>
  <a class="flex items-center font-extrabold tracking-[0.12em] text-slate-300" href="/">
    <Image class="aspect-auto w-20" src={logo} alt="" width={logo.width} height={logo.height} />
    <p class="flex flex-col">
      IluminAconCiencia
      <span class="text-[0.65rem] font-medium tracking-wider">Región de Coquimbo</span>
    </p>
  </a>
  <nav class="flex items-center gap-6" aria-label="Navegación principal">
    <a class="block text-slate-300 no-underline transition-colors hover:text-accent" href="/#hero">Por qué importa</a>
    <a class="block rounded-md bg-accent px-4 py-2 font-sans text-black" href="#"
      >Abrir <strong class="ml-1">CALUZ</strong></a
    >
  </nav>
</header>
