---
import '@styles/global.css'
import Header from '@shared/components/Header.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'CALUZ · Red de observación',
  description = 'Punto de entrada provisional y accesible a la red de observación CALUZ.'
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="relative h-full min-h-screen antialiased">
    <Header />
    <main><slot /></main>
  </body>
</html>
