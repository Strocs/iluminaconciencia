---
import type { HTMLAttributes } from 'astro/types';

import { cn } from '../../utils/cn';

type Size = 'sm' | 'md';

type NativeButtonProps = Omit<HTMLAttributes<'button'>, 'class' | 'size'>;

export interface Props extends NativeButtonProps {
  class?: string;
  size?: Size;
}

const {
  class: className,
  size = 'md',
  type = 'button',
  disabled = false,
  ...rest
} = Astro.props;

const sizeClasses: Record<Size, string> = {
  sm: 'h-7 px-3 text-sm/normal',
  md: 'h-10 px-5 text-xl/normal',
};
---

<button
  {...rest}
  type={type}
  disabled={disabled}
  class={cn(
    'inline-flex cursor-pointer items-center justify-center rounded-full border border-border bg-transparent font-body font-medium text-primary outline-none transition-colors enabled:hover:border-primary enabled:hover:bg-primary enabled:hover:text-background enabled:active:scale-95 motion-reduce:active:scale-100 motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:border-border disabled:bg-transparent disabled:text-text disabled:opacity-50',
    sizeClasses[size],
    className,
  )}
>
  <slot />
</button>
