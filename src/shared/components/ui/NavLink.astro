---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '../../utils/cn'
import BrandStarIcon from './BrandStarIcon.astro'

type NativeAnchorProps = Omit<HTMLAttributes<'a'>, 'class' | 'href'>

export interface Props extends NativeAnchorProps {
  active?: boolean
  class?: string
  disabled?: boolean
  href: string
  variant?: 'desktop' | 'mobile'
}

const {
  active = false,
  class: className,
  disabled = false,
  href,
  variant = 'desktop',
  tabindex,
  'aria-current': ariaCurrent,
  'aria-disabled': ariaDisabled,
  ...rest
} = Astro.props

const current = disabled ? undefined : active ? 'page' : ariaCurrent
---

<a
  {...rest}
  data-nav-link
  href={disabled ? undefined : href}
  tabindex={disabled ? -1 : tabindex}
  aria-disabled={disabled ? 'true' : ariaDisabled}
  aria-current={current}
  class={cn(
    'group/nav-link relative inline-flex font-body text-text transition-colors outline-none hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none',
    variant === 'mobile' && 'text-xl',
    className,
    active && 'text-accent',
    disabled && 'pointer-events-none cursor-not-allowed text-text opacity-50'
  )}
>
  <span
    class="relative inline-flex transition-transform duration-200 ease-out group-hover/nav-link:-translate-y-1 group-focus-visible/nav-link:-translate-y-1 motion-reduce:transform-none motion-reduce:transition-none"
  >
    <span><slot /></span>
    <BrandStarIcon
      class={cn(
        'absolute top-full left-1/2 mt-px -translate-x-1/2 text-accent transition-opacity duration-200 ease-out motion-reduce:transition-none',
        disabled
          ? 'opacity-0'
          : active
            ? 'opacity-100'
            : 'opacity-0 group-hover/nav-link:opacity-100 group-focus-visible/nav-link:opacity-100'
      )}
    />
  </span>
</a>

<script>
  document.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return
    }

    const eventTarget = event.target
    if (!(eventTarget instanceof Element)) return

    const link = eventTarget.closest<HTMLAnchorElement>('a[data-nav-link]')
    const href = link?.getAttribute('href')
    if (!link || !href?.startsWith('#')) return

    const targetId = href.slice(1)
    if (!targetId) return

    const target = document.querySelector<HTMLElement>(`#${CSS.escape(targetId)}`)
    if (!target) return

    event.preventDefault()
    target.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      block: 'start'
    })

    const hadTabindex = target.hasAttribute('tabindex')
    if (!hadTabindex) target.setAttribute('tabindex', '-1')
    target.focus({ preventScroll: true })

    if (!hadTabindex) {
      target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true })
    }
  })
</script>
