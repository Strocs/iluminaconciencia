---
import { Font } from 'astro:assets'
import '@styles/global.css'
import Header from '@shared/components/header/Header.astro'
import Background from '@shared/components/Background.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Iluminaconciencia · Red de observación',
  description = 'Punto de entrada provisional y accesible a la red de observación Iluminaconciencia.'
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <Font cssVariable="--font-baskervville" />
    <Font cssVariable="--font-ubuntu" />
    <title>{title}</title>
  </head>
  <body class="relative isolate h-full min-h-screen font-body antialiased">
    <Background />
    <Header />
    <main><slot /></main>
  </body>
</html>
