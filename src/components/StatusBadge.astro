---
import type { ObservationStatus } from '../domain/observation-point'
const { status } = Astro.props as { status: ObservationStatus }
const labels = { available: 'Disponible', outdated: 'Desactualizado', 'no-data': 'Sin datos' }
---

<span
  class={`inline-flex items-center gap-1 whitespace-nowrap text-xs font-bold ${status === 'available' ? 'text-status' : status === 'outdated' ? 'text-accent' : 'text-muted'}`}
  ><span aria-hidden="true">●</span> {labels[status]}</span
>
