---
import StatusBadge from './StatusBadge.astro'
import type { MapNetwork } from '../domain/observation-point'
import '../features/observation-points/map.css'
const { network } = Astro.props as { network: MapNetwork }
---

<div class="map-layout">
  <div class="map-schematic" aria-label="Vista esquemática de los puntos de observación" role="img">
    <div class="map-lines" aria-hidden="true"></div>
    {
      network.points.map((point, index) => (
        <a class={`map-point point-${index + 1}`} href={`/points/${point.id}`} aria-label={`Abrir ${point.name}`}>
          {index + 1}
        </a>
      ))
    }
    <p class="map-note">Vista esquemática provisional · proveedor de mapas no seleccionado</p>
  </div>
  <div class="grid gap-3">
    {
      network.points.map((point) => (
        <article class="card">
          <>
            <div class="flex items-start justify-between gap-4">
              <>
                <div>
                  <>
                    <p class="eyebrow">{point.region}</p>
                    <h3>{point.name}</h3>
                  </>
                </div>
                <StatusBadge status={point.status} />
              </>
            </div>
            <p class="leading-normal text-subtle">{point.everydayMeaning}</p>
            <p class="text-xs text-faint">
              {point.updatedAt ? `Actualizado el ${point.updatedAt}` : 'Aún no hay fecha de observación'}
            </p>
            <a class="text-link" href={`/points/${point.id}`}>
              Leer ficha del punto <span aria-hidden="true">→</span>
            </a>
          </>
        </article>
      ))
    }
  </div>
</div>
