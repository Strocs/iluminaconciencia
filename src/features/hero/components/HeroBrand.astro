---
import { Image } from 'astro:assets'
import logo from '@assets/iluminaconciencia-logo.png'
---

<Image
  class="absolute top-32 right-0 left-0 mx-auto size-16 object-contain sm:size-42 [@media(max-height:34rem)]:size-16"
  src={logo}
  alt="IluminaConCiencia"
  width={logo.width}
  height={logo.height}
/>
