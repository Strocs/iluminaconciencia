---
import { skyRendering } from '../config/sky-rendering'
const { baseColor, domeHeightFactor, domeWidthFactor, horizonSinkFactor } = skyRendering.pollution
const { red, green, blue } = baseColor
const boostedRed = Math.round(red * 1.12)
const boostedGreen = Math.round(green * 1.12)
const boostedBlue = Math.round(blue * 1.12)
const restCenter = 1 / (1 + horizonSinkFactor)
// Static baseline (progress 0). The GSAP timeline tween (normal motion branch)
// starts from these exact values and interpolates toward the sunk/faded state;
// the reduced-motion branch inherits this static state unchanged.
const pollutionStyle = [
  `background: radial-gradient(ellipse ${domeWidthFactor * 100}vw ${domeHeightFactor * 100}dvh at 50% calc(var(--cy) * 100%), rgba(${boostedRed}, ${boostedGreen}, ${boostedBlue}, 0.9) 0%, rgba(${red}, ${green}, ${blue}, 0.4) 30%, rgba(${red}, ${green}, ${blue}, 0.15) 60%, rgba(${red}, ${green}, ${blue}, 0.05) 85%, rgba(${red}, ${green}, ${blue}, 0) 100%)`,
  `height: ${(1 + horizonSinkFactor) * 100}dvh`,
  `--cy: ${restCenter}`,
  'opacity: 1'
].join('; ')
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  <canvas data-hero-stars class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <div
    data-hero-light-pollution
    class="pointer-events-none absolute inset-x-0 top-0"
    style={pollutionStyle}
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-hero-canvas/50 via-hero-canvas/10 to-hero-canvas/60"></div>
</div>
