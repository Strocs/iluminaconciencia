---
import HeroScene from './HeroScene.astro'
import { heroScenes } from '../data/hero-scenes'
---

<div class="relative z-10 mx-auto flex h-full w-full max-w-4xl flex-1 flex-col items-center justify-center">
  <div class="relative h-full w-full px-6">
    {heroScenes.map((scene, index) => <HeroScene scene={scene} index={index} />)}
  </div>
</div>
