---
import { heroMessages } from './content';
import './hero.css';
---

<script is:inline>
  document.documentElement.classList.add('js');
</script>

<section class="hero-narrative" id="hero" aria-labelledby="hero-title">
  <div class="hero-narrative__sticky">
    <div class="hero-sky" aria-hidden="true">
      <div class="hero-sky__photograph"></div>
      <canvas class="hero-sky__canvas" aria-hidden="true"></canvas>
      <div class="hero-sky__glow"></div>
      <div class="hero-sky__haze"></div>
      <div class="hero-sky__horizon"></div>
    </div>
    <div class="hero-narrative__content">
      <div class="hero-narrative__stage">
        <div class="hero-narrative__opening">
          <p class="eyebrow">IluminaConCiencia · Región de Coquimbo</p>
          <h1 id="hero-title">
            Medimos la contaminación lumínica para proteger los cielos de la Región de Coquimbo.
          </h1>
          <p class="hero-copy">
            IluminaConCiencia genera información territorial para comprender el problema y apoyar
            mejores decisiones.
          </p>
        </div>
        <div class="hero-narrative__messages" aria-label="Narrativa del proyecto">
          {
            heroMessages.map((message, index) => (
              <article class="hero-message" data-hero-message={index}>
                <p class="eyebrow">{message.eyebrow}</p>
                <h2>{message.title}</h2>
                <p>{message.copy}</p>
              </article>
            ))
          }
          <article class="hero-message hero-message--closing" data-hero-message="closing">
            <p class="eyebrow">Un derecho compartido</p>
            <h2>Contemplar el firmamento es un derecho de todas y todos.</h2>
          </article>
        </div>
      </div>
      <div class="hero-narrative__footer">
        <div class="actions">
          <a class="button button-primary" href="#map">Explorar el mapa</a>
          <a class="button text-ink" href="#map">Ir directamente a los datos</a>
        </div>
        <span class="hero-progress" aria-hidden="true"><span></span></span>
      </div>
    </div>
  </div>
</section>

<script src="./motion.ts"></script>
<script src="./star-field.ts"></script>
