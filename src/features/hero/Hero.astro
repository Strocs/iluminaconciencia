---
import HeroNarrative from './capabilities/scenes/HeroNarrative.astro'
import HeroSky from './capabilities/night-sky/HeroSky.astro'
import BortleScale from './capabilities/bortle-scale/BortleScale.astro'
---

<section id="hero" class="relative min-h-[550dvh]" aria-labelledby="hero-title">
  <div data-hero-pin-layer class="h-dvh overflow-hidden pb-4">
    <div class="hero-clip relative h-full">
      <HeroSky />
      <div
        class="relative z-10 mx-auto flex h-full w-full flex-col items-center justify-center gap-8 pt-32 pb-32 sm:gap-12 [@media(max-height:38rem)]:gap-4 [@media(max-height:38rem)]:pt-24 [@media(max-height:38rem)]:pb-28"
      >
        <HeroNarrative />
        <BortleScale />
      </div>
      <div class="pointer-events-none absolute inset-x-0 bottom-8 z-20 flex flex-col items-center gap-3">
        <p class="font-body text-sm tracking-wider text-text">Desliza para descubrir</p>
        <span class="h-12 w-px bg-linear-to-b from-text to-transparent" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { initializeHero } from './runtime/initialize-hero'

  const root = document.querySelector<HTMLElement>('#hero')
  if (root) initializeHero(root)
</script>

<style>
  .hero-clip {
    -webkit-mask: url('/images/hero/lower-arc-mask.svg') center / 1280px 100% no-repeat;
    mask: url('/images/hero/lower-arc-mask.svg') center / 1280px 100% no-repeat;
  }

  @media (min-width: 1280px) {
    .hero-clip {
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
    }
  }
</style>
