---
import { lightPollutionConfig } from './config'

const { palette, horizon } = lightPollutionConfig
---

<div
  data-hero-light-pollution-horizon
  class="pointer-events-none absolute inset-x-0 bottom-0 h-full bg-[linear-gradient(to_top,var(--horizon-color)_0%,transparent_100%)]"
  style={`--horizon-color: ${palette.source}; opacity: ${horizon.initialOpacity};`}
  aria-hidden="true"
></div>
