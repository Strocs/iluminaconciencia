---
import { lightPollutionConfig } from './config'

const { palette, source, halo, geometry } = lightPollutionConfig
const [referenceStopOne, referenceStopTwo, referenceStopThree] = halo.reference.stops
const [referenceAlphaOne, referenceAlphaTwo, referenceAlphaThree] = halo.reference.alphas
---

<div
  data-hero-light-pollution-source
  class="light-pollution-source pointer-events-none absolute"
  style={`
    --source-color: ${palette.source};
    --source-opacity: ${source.initialOpacity};
    --source-width: ${geometry.source.mobile.width}vw;
    --source-height: ${geometry.source.mobile.height}lvh;
    --source-x: ${geometry.source.mobile.x}vw;
    --source-y: ${geometry.source.mobile.y}lvh;
    --source-width-desktop: ${geometry.source.desktop.width}vw;
    --source-height-desktop: ${geometry.source.desktop.height}lvh;
    --source-x-desktop: ${geometry.source.desktop.x}vw;
    --source-y-desktop: ${geometry.source.desktop.y}lvh;
  `}
  aria-hidden="true"
>
</div>

<div
  data-hero-light-pollution-halo
  class="light-pollution-halo pointer-events-none absolute"
  style={`
    --halo-color-one: ${palette.source};
    --halo-color-two: ${palette.middle};
    --halo-color-three: ${palette.edge};
    --halo-stop-one: ${referenceStopOne}%;
    --halo-stop-two: ${referenceStopTwo}%;
    --halo-stop-three: ${referenceStopThree}%;
    --halo-alpha-one: ${referenceAlphaOne};
    --halo-alpha-two: ${referenceAlphaTwo};
    --halo-alpha-three: ${referenceAlphaThree};
    --halo-width: ${geometry.halo.mobile.width}vw;
    --halo-height: ${geometry.halo.mobile.height}lvh;
    --halo-x: ${geometry.halo.mobile.x}vw;
    --halo-y: ${geometry.halo.mobile.y}lvh;
    --halo-focus-x: ${geometry.halo.mobile.focusX}%;
    --halo-focus-y: ${geometry.halo.mobile.focusY}%;
    --halo-width-desktop: ${geometry.halo.desktop.width}vw;
    --halo-height-desktop: ${geometry.halo.desktop.height}lvh;
    --halo-x-desktop: ${geometry.halo.desktop.x}vw;
    --halo-y-desktop: ${geometry.halo.desktop.y}lvh;
    --halo-focus-x-desktop: ${geometry.halo.desktop.focusX}%;
    --halo-focus-y-desktop: ${geometry.halo.desktop.focusY}%;
  `}
  aria-hidden="true"
>
</div>

<style>
  .light-pollution-source {
    left: var(--source-x);
    top: var(--source-y);
    width: var(--source-width);
    height: var(--source-height);
    opacity: var(--source-opacity);
    border-radius: 62% 38% 54% 46% / 56% 48% 52% 44%;
    background: radial-gradient(ellipse at 44% 56%, var(--source-color) 0%, transparent 72%);
    filter: blur(12px);
    transform: translate(-50%, -50%) rotate(-8deg);
    transform-origin: center;
    will-change: opacity;
  }

  .light-pollution-halo {
    --halo-render-focus-x: var(--halo-focus-x);
    --halo-render-focus-y: var(--halo-focus-y);
    left: var(--halo-x);
    top: var(--halo-y);
    width: var(--halo-width);
    height: var(--halo-height);
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse at var(--halo-render-focus-x) var(--halo-render-focus-y),
      rgb(from var(--halo-color-one) r g b / var(--halo-alpha-one)) var(--halo-stop-one),
      rgb(from var(--halo-color-two) r g b / var(--halo-alpha-two)) var(--halo-stop-two),
      rgb(from var(--halo-color-three) r g b / var(--halo-alpha-three)) var(--halo-stop-three)
    );
  }

  @media (min-width: 768px) {
    .light-pollution-source {
      left: var(--source-x-desktop);
      top: var(--source-y-desktop);
      width: var(--source-width-desktop);
      height: var(--source-height-desktop);
    }

    .light-pollution-halo {
      left: var(--halo-x-desktop);
      top: var(--halo-y-desktop);
      width: var(--halo-width-desktop);
      height: var(--halo-height-desktop);
      --halo-render-focus-x: var(--halo-focus-x-desktop);
      --halo-render-focus-y: var(--halo-focus-y-desktop);
    }
  }
</style>
