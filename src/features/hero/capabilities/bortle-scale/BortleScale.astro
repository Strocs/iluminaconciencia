---
import { bortleClasses } from '@shared/features/bortle'
import { bortleConfig } from './config'

const { focusX, nodeSpacing } = bortleConfig.visual
const trackWidth = nodeSpacing * (bortleClasses.length - 1) + 18
---

<section
  data-hero-bortle-scale
  aria-label="Escala de Bortle"
  class="bortle-scale z-20 mx-auto grid w-[calc(100%-3rem)] max-w-lg grid-cols-[208px_208px] items-center gap-18 px-0 font-body max-sm:w-full max-sm:grid-cols-1 max-sm:gap-4 max-sm:px-6 max-sm:text-center [@media(max-height:38rem)]:gap-2"
>
  <div class="bortle-copy relative min-h-24 text-right max-sm:min-h-22 max-sm:text-center">
    {
      bortleClasses.map((bortleClass, index) => (
        <div
          data-hero-bortle-panel={bortleClass.level}
          aria-current={index === 0 ? 'true' : undefined}
          hidden={index !== 0}
          class="absolute inset-0 flex flex-col justify-center"
        >
          <p class="text-[1.45rem] leading-none font-medium tracking-[0.01em] text-primary">
            BORTLE {bortleClass.level}
          </p>
          <p class="mt-2 text-sm leading-tight font-normal text-white/90">{bortleClass.name}</p>
          <p class="mt-2 text-xs leading-none font-light text-white/65">{bortleClass.sqmRange} Mag. arc/seg²</p>
        </div>
      ))
    }
  </div>

  <div class="bortle-presentation relative h-16 w-[208px] max-sm:mx-auto" aria-hidden="true">
    <div class="bortle-crop absolute -top-[30px] right-0 -bottom-[30px] left-0 overflow-hidden">
      <div
        data-hero-bortle-track
        class="bortle-track absolute top-[38px] left-0 h-12 will-change-transform"
        style={`--bortle-focus-x: ${focusX}px; width: ${trackWidth}px`}
      >
        {
          bortleClasses.slice(0, -1).map((bortleClass, index) => (
            <>
              <span
                data-hero-bortle-base-connector
                class="absolute top-2 h-px origin-left bg-[#616268] opacity-40"
                style={`left: ${index * nodeSpacing}px; width: ${nodeSpacing}px`}
              />
              <span
                data-hero-bortle-connector={bortleClass.level}
                class="absolute top-2 h-px origin-left scale-x-0 bg-primary opacity-0 shadow-[0_0_8px_#f4bd63] will-change-transform"
                style={`left: ${index * nodeSpacing}px; width: ${nodeSpacing}px`}
              />
            </>
          ))
        }
        {
          bortleClasses.map((bortleClass, index) => (
            <div
              data-hero-bortle-node={bortleClass.level}
              data-active={index === 0 ? '' : undefined}
              class="bortle-node absolute top-0 flex -translate-x-1/2 flex-col items-center"
              style={`left: ${index * nodeSpacing}px`}
            >
              <span class="bortle-dot block size-[18px] rounded-full bg-[#616268] will-change-transform" />
              <span class="mt-2 text-xs leading-none text-[#87888d]">{bortleClass.level}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .bortle-scale {
    color: white;
  }

  .bortle-track {
    transform: translateX(var(--bortle-focus-x));
  }

  .bortle-dot {
    transform: scale(0.56);
  }

  .bortle-node {
    opacity: 0.2;
  }

  .bortle-node:nth-of-type(1) {
    opacity: 1;
  }

  .bortle-node:nth-of-type(2) {
    opacity: 0.7;
  }

  .bortle-node:nth-of-type(3) {
    opacity: 0.5;
  }

  .bortle-node:nth-of-type(4) {
    opacity: 0.33;
  }

  .bortle-node[data-active] .bortle-dot {
    transform: scale(1);
    background: #f4bd63;
    box-shadow:
      0 0 7px #f4bd63,
      0 0 22px rgb(244 189 99 / 55%);
  }

  .bortle-node[data-active] span:last-child {
    color: #f4bd63;
  }

  @media (max-width: 639px) and (max-height: 38rem) {
    .bortle-scale {
      row-gap: 0.25rem;
    }

    .bortle-copy {
      min-height: 3.75rem;
    }

    .bortle-presentation {
      height: 3rem;
    }
  }
</style>
