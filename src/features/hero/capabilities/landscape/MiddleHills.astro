---
import { hillPaths } from './svg-path'

const hill = hillPaths.middle
---

<div
  class="pointer-events-none absolute bottom-0 left-1/2 z-20"
  style="--hill-scale: 1; --hill-offset-x: 0px; --hill-offset-y: 0px; width: var(--hero-art-width); height: var(--hero-art-height); transform: translate(calc(-50% + var(--hill-offset-x)), calc(var(--hill-offset-y) + var(--hero-art-offset-y))) scale(var(--hill-scale)); transform-origin: bottom center;"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 2400 1700"
    preserveAspectRatio="xMidYMax meet"
    class="size-full"
    aria-hidden="true"
  >
    <path d={hill.d} class="fill-neutral-950" />
  </svg>
</div>
