---
import LinkButton from '../../../../shared/components/ui/LinkButton.astro'
import type { HeroScene } from './scenes-data'

const { scene, index } = Astro.props as {
  scene: HeroScene
  index: number
}
---

<article
  class:list={[
    'hero-scene absolute inset-0 flex flex-col items-center justify-center p-6 text-center sm:p-10 [@media(max-height:34rem)]:p-3',
    index === 0 ? 'opacity-100' : 'opacity-0'
  ]}
  data-hero-scene={scene.id}
  aria-hidden={index === 0 ? undefined : 'true'}
  inert={index === 0 ? undefined : true}
>
  <div class="scene-content flex flex-col items-center gap-4 [@media(max-width:639px)_and_(max-height:38rem)]:gap-3">
    <h1
      id={index === 0 ? 'hero-title' : undefined}
      class="scene-heading max-w-3xl font-heading text-5xl leading-14 font-semibold text-foreground [text-box-trim:trim-both] [@media(max-width:639px)_and_(max-height:38rem)]:text-4xl [@media(max-width:639px)_and_(max-height:38rem)]:leading-10"
    >
      {scene.title.before}<span class="text-primary">{scene.title.highlight}</span>{scene.title.after}
    </h1>
    {scene.copy && <p class="max-w-lg font-body text-base leading-6 font-normal text-text">{scene.copy}</p>}
    <LinkButton variant="important" href={scene.cta.href}>{scene.cta.label}</LinkButton>
  </div>
</article>
