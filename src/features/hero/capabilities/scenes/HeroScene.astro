---
import type { HeroScene } from './scenes-data'

const { scene, index } = Astro.props as {
  scene: HeroScene
  index: number
}
---

<article
  class:list={[
    'absolute inset-0 flex flex-col items-center justify-center p-6 text-center sm:p-10 [@media(max-height:34rem)]:p-3',
    index === 0 ? 'opacity-100' : 'opacity-0'
  ]}
  data-hero-scene={scene.id}
  aria-hidden={index === 0 ? undefined : 'true'}
  inert={index === 0 ? undefined : true}
>
  <div class="flex flex-col items-center gap-4">
    <h1
      id={index === 0 ? 'hero-title' : undefined}
      class="max-w-3xl font-heading text-5xl leading-15 font-semibold text-foreground"
    >
      {scene.title.before}<span class="text-primary">{scene.title.highlight}</span>{scene.title.after}
    </h1>
    {
      scene.copy && (
        <p class="max-w-lg font-body text-base leading-6 font-normal text-text">
          {scene.copy}
        </p>
      )
    }
  </div>
  {
    index === 0 && (
      <div class="relative flex flex-col items-center gap-2">
        <div class="h-12 w-px bg-linear-to-b from-foreground/50 to-transparent" />
        <span class="font-mono text-[9px] tracking-[0.3em] text-text uppercase opacity-50">
          Desliza para conocer más
        </span>
      </div>
    )
  }
</article>
