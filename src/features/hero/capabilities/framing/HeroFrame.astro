---
import { hillPaths } from '../landscape/svg-path'

const nearest = hillPaths.nearest
const maskSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="2400" height="1700" viewBox="0 0 2400 1700"><rect width="2400" height="1700" fill="white"/><path d="${nearest.d}" fill="black"/></svg>`
const nearestMaskImage = `url("data:image/svg+xml,${encodeURIComponent(maskSvg)}")`
---

<div class="relative isolate h-full overflow-x-clip overflow-y-visible">
  <div
    class="hero-frame__composition absolute inset-x-0 top-0 mx-auto w-full max-w-[120rem] bg-black"
    style={`--hero-art-width: min(120rem, 250vw); --hero-art-height: calc(var(--hero-art-width) * 17 / 24); --hero-art-offset-y: calc(var(--hero-art-width) * 182.5 / 2400); --hero-nearest-mask-image: ${nearestMaskImage}; height: calc(100% + var(--hero-art-offset-y));`}
  >
    <div class="relative" style="height: calc(100% - var(--hero-art-offset-y));">
      <slot />
    </div>
  </div>
</div>

<style>
  /* The independent mask image shares the landscape's 2400:1700 viewport and bottom-centered CSS sizing. */
  .hero-frame__composition {
    -webkit-mask-image:
      var(--hero-nearest-mask-image),
      linear-gradient(
        to bottom,
        white 0,
        white max(0px, calc(100% - var(--hero-art-height))),
        transparent max(0px, calc(100% - var(--hero-art-height))),
        transparent 100%
      );
    -webkit-mask-size: var(--hero-art-width) var(--hero-art-height), 100% 100%;
    -webkit-mask-position: center 100%, 0 0;
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-composite: source-over;
    mask-image:
      var(--hero-nearest-mask-image),
      linear-gradient(
        to bottom,
        white 0,
        white max(0px, calc(100% - var(--hero-art-height))),
        transparent max(0px, calc(100% - var(--hero-art-height))),
        transparent 100%
      );
    mask-size: var(--hero-art-width) var(--hero-art-height), 100% 100%;
    mask-position: center 100%, 0 0;
    mask-repeat: no-repeat, no-repeat;
    mask-mode: luminance, alpha;
    mask-composite: add;
  }
</style>
