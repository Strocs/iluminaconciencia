---
import BortleBar from '@shared/components/BortleBar.astro'
---

<section id="nodos" class="relative z-10 h-full min-h-[90dvh] w-full p-4 sm:p-6">
  <div class="mx-auto h-full">
    <!-- <h2 class="font-serif text-3xl text-ink">Nodos de medición</h2> -->
    <!-- <p class="mt-2 max-w-2xl text-sm leading-relaxed text-subtle"> -->
    <!--   Red de monitoreo de la contaminación lumínica en la Región de Coquimbo. Filtra los puntos por tipo de instrumento -->
    <!--   o por escala Bortle, y selecciona un nodo para ver su detalle. -->
    <!-- </p> -->

    <div class="relative h-[90vh] overflow-hidden rounded-2xl border border-border bg-surface">
      <div id="map" class="size-full overflow-hidden"></div>

      <div class="pointer-events-none absolute inset-x-4 top-4 flex flex-wrap gap-3">
        <fieldset
          data-type-filters
          class="pointer-events-auto rounded-xl border border-border bg-canvas/80 p-3 backdrop-blur"
        >
          <legend class="px-1 text-xs font-medium text-muted">Tipo de instrumento</legend>
          <div data-type-chips class="mt-2 flex flex-wrap gap-2"></div>
        </fieldset>
        <div
          data-bortle-filters
          class="pointer-events-auto rounded-xl border border-border bg-canvas/80 p-3 backdrop-blur"
        >
          <BortleBar />
        </div>
      </div>

      <aside
        id="instrument-drawer"
        class="absolute inset-y-0 right-0 z-10 flex h-full w-full max-w-sm translate-x-full flex-col overflow-y-auto border-l border-border bg-surface p-5 shadow-2xl transition-transform duration-300"
        aria-hidden="true"
      >
        <header class="sticky top-0 flex shrink-0 items-start justify-between gap-4 bg-surface pb-2">
          <h3 data-drawer-title class="font-serif text-xl leading-snug text-ink"></h3>
          <button
            data-drawer-close
            type="button"
            class="rounded-full border border-border px-2.5 py-1 text-muted transition-colors hover:text-ink"
            aria-label="Cerrar panel"
          >
            ✕
          </button>
        </header>
        <dl data-drawer-rows class="mt-5 space-y-3"></dl>
        <a
          data-drawer-link
          href="#"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-full bg-accent px-5 py-2 text-sm font-semibold text-canvas transition-opacity hover:opacity-90"
        >
          Más información
        </a>
      </aside>
    </div>
  </div>
</section>

<script>
  import { loadInstruments } from '@shared/features/instruments'
  import { bortleClasses } from '@shared/features/bortle'
  import { createBortleFilter } from './bortle-filter'
  import { createInstrumentDrawer } from './drawer'
  import { filterByBortle, filterByType } from './filters'
  import { renderPin } from './pin-view'
  import { createMaplibreView } from './providers/maplibre'

  const mapEl = document.getElementById('map')
  const drawerEl = document.getElementById('instrument-drawer')
  if (!mapEl || !drawerEl) throw new Error('Map section is missing a required element')

  const instruments = loadInstruments()
  const drawer = createInstrumentDrawer(drawerEl)

  // Filter options derive from the data itself, so new instrument types
  // or Bortle levels appear automatically — the contract stays open.
  const types = [...new Set(instruments.map((instrument) => instrument.type))].sort()
  const selectedTypes = new Set(types)

  function chipClass(active: boolean): string {
    return active
      ? 'rounded-full bg-accent px-3 py-1 text-xs font-semibold text-canvas'
      : 'rounded-full border border-border bg-surface px-3 py-1 text-xs text-subtle transition-colors hover:text-ink'
  }

  function renderTypeChips(
    container: HTMLElement,
    values: readonly string[],
    selected: Set<string>,
    onToggle: (value: string) => void
  ): void {
    container.replaceChildren(
      ...values.map((value) => {
        const chip = document.createElement('button')
        chip.type = 'button'
        chip.textContent = String(value)
        chip.className = chipClass(selected.has(value))
        chip.setAttribute('aria-pressed', String(selected.has(value)))
        chip.addEventListener('click', () => {
          onToggle(value)
          chip.className = chipClass(selected.has(value))
          chip.setAttribute('aria-pressed', String(selected.has(value)))
        })
        return chip
      })
    )
  }

  let selectedLevels: ReadonlySet<number> = new Set(bortleClasses.map(({ level }) => level))

  renderTypeChips(document.querySelector<HTMLElement>('[data-type-chips]')!, types, selectedTypes, (type) => {
    selectedTypes.has(type) ? selectedTypes.delete(type) : selectedTypes.add(type)
    refresh()
  })

  const bortleFilterRoot = document.querySelector<HTMLElement>('[data-bortle-filters]')
  if (!bortleFilterRoot) throw new Error('Map section is missing the Bortle filter')
  createBortleFilter({
    root: bortleFilterRoot,
    classes: bortleClasses,
    onToggle: (selected) => {
      selectedLevels = new Set(selected)
      refresh()
    }
  })

  // MapLibre GL JS (~900 KB) is loaded dynamically so it splits into a separate
  // chunk instead of blocking the initial bundle. Pins are attached once the
  // view is ready; filters update the already-created view.
  const view = await createMaplibreView({ container: mapEl })
  view.onPinClick((instrument) => drawer.open(instrument))

  function refresh(): void {
    const filtered = filterByBortle(filterByType(instruments, selectedTypes), selectedLevels)
    view.setPins(filtered, renderPin)
  }
  refresh()
</script>
