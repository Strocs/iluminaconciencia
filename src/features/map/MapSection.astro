---
// Map section shell — static markup only; all interactivity lives in the script.
---

<section id="nodos" class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <h2 class="font-serif text-3xl text-ink">Nodos de medición</h2>
  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-subtle">
    Red de monitoreo de la contaminación lumínica en la Región de Coquimbo. Filtra los puntos por tipo de
    instrumento o por escala Bortle, y selecciona un nodo para ver su detalle.
  </p>

  <div class="relative mt-8">
    <div id="map" class="h-[500px] w-full overflow-hidden rounded-2xl border border-border bg-surface"></div>

    <div class="pointer-events-none absolute inset-x-4 top-4 flex flex-wrap gap-3">
      <fieldset
        data-type-filters
        class="pointer-events-auto rounded-xl border border-border bg-canvas/80 p-3 backdrop-blur"
      >
        <legend class="px-1 text-xs font-medium text-muted">Tipo de instrumento</legend>
        <div data-type-chips class="mt-2 flex flex-wrap gap-2"></div>
      </fieldset>
      <fieldset
        data-bortle-filters
        class="pointer-events-auto rounded-xl border border-border bg-canvas/80 p-3 backdrop-blur"
      >
        <legend class="px-1 text-xs font-medium text-muted">Escala Bortle</legend>
        <div data-bortle-chips class="mt-2 flex flex-wrap gap-2"></div>
      </fieldset>
    </div>

    <aside
      id="instrument-drawer"
      class="absolute inset-y-0 right-0 z-10 w-full max-w-sm translate-x-full border-l border-border bg-surface p-5 shadow-2xl transition-transform duration-300"
      aria-hidden="true"
    >
      <header class="flex items-start justify-between gap-4">
        <h3 data-drawer-title class="font-serif text-xl leading-snug text-ink"></h3>
        <button
          data-drawer-close
          type="button"
          class="rounded-full border border-border px-2.5 py-1 text-muted transition-colors hover:text-ink"
          aria-label="Cerrar panel"
        >
          ✕
        </button>
      </header>
      <dl data-drawer-rows class="mt-5 space-y-3"></dl>
      <a
        data-drawer-link
        href="#"
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-full bg-accent px-5 py-2 text-sm font-semibold text-canvas transition-opacity hover:opacity-90"
      >
        Más información
      </a>
    </aside>
  </div>
</section>

<script>
  import { loadInstruments } from '@shared/features/instruments'
  import { createInstrumentDrawer } from './drawer'
  import { filterByBortle, filterByType } from './filters'
  import { renderPin } from './pin-view'
  import { createMaplibreView } from './providers/maplibre'

  const mapEl = document.getElementById('map')
  const drawerEl = document.getElementById('instrument-drawer')
  if (!mapEl || !drawerEl) throw new Error('Map section is missing a required element')

  const instruments = loadInstruments()
  const view = createMaplibreView({ container: mapEl })
  const drawer = createInstrumentDrawer(drawerEl)

  // Filter options derive from the data itself, so new instrument types
  // or Bortle levels appear automatically — the contract stays open.
  const types = [...new Set(instruments.map((instrument) => instrument.type))].sort()
  const levels = [
    ...new Set(instruments.flatMap((instrument) => (instrument.bortleLevel === null ? [] : [instrument.bortleLevel])))
  ].sort((a, b) => a - b)

  const selectedTypes = new Set(types)
  const selectedLevels = new Set(levels)

  function chipClass(active: boolean): string {
    return active
      ? 'rounded-full bg-accent px-3 py-1 text-xs font-semibold text-canvas'
      : 'rounded-full border border-border bg-surface px-3 py-1 text-xs text-subtle transition-colors hover:text-ink'
  }

  function renderChips<T extends string | number>(
    container: HTMLElement,
    values: readonly T[],
    selected: Set<T>,
    onToggle: (value: T) => void
  ): void {
    container.replaceChildren(
      ...values.map((value) => {
        const chip = document.createElement('button')
        chip.type = 'button'
        chip.textContent = String(value)
        chip.className = chipClass(selected.has(value))
        chip.setAttribute('aria-pressed', String(selected.has(value)))
        chip.addEventListener('click', () => {
          onToggle(value)
          chip.className = chipClass(selected.has(value))
          chip.setAttribute('aria-pressed', String(selected.has(value)))
        })
        return chip
      })
    )
  }

  renderChips(
    document.querySelector<HTMLElement>('[data-type-chips]')!,
    types,
    selectedTypes,
    (type) => {
      selectedTypes.has(type) ? selectedTypes.delete(type) : selectedTypes.add(type)
      refresh()
    }
  )

  renderChips(
    document.querySelector<HTMLElement>('[data-bortle-chips]')!,
    levels,
    selectedLevels,
    (level) => {
      selectedLevels.has(level) ? selectedLevels.delete(level) : selectedLevels.add(level)
      refresh()
    }
  )

  function refresh(): void {
    const filtered = filterByBortle(filterByType(instruments, selectedTypes), selectedLevels)
    view.setPins(filtered, renderPin)
  }

  view.onPinClick((instrument) => drawer.open(instrument))
  refresh()
</script>