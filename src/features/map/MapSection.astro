---
import Header from '@shared/components/ui/Header.astro'
import { bortleClasses } from '@shared/features/bortle'
import { loadInstruments } from '@shared/features/instruments'

const instrumentCount = loadInstruments().length
const countLabel = `${instrumentCount} ${instrumentCount === 1 ? 'punto disponible' : 'puntos disponibles'}`
---

<section
  id="nodos"
  class="relative z-10 flex min-h-[max(100dvh,768px)] w-full flex-col px-4 pb-4 text-foreground sm:px-5 sm:pb-5"
>
  <Header data-map-header eyebrow="02 / EXPLORAR" title="Puntos de Medición" subtitle={countLabel} class="shrink-0" />

  <div data-map-workspace class="relative mx-auto flex min-h-0 w-full max-w-[90rem] flex-1 gap-4">
    <aside
      data-filter-panel
      aria-label="Filtros del mapa"
      aria-hidden="false"
      class="map-panel flex w-[153px] shrink-0 flex-col overflow-y-auto bg-transparent p-0 pt-8"
    >
      <div class="flex items-center justify-between md:hidden">
        <h3 class="font-heading text-xl font-bold">Filtros</h3>
        <button data-filter-close type="button" class="text-xs text-foreground" aria-label="Cerrar filtros">Cerrar</button>
      </div>
      <div class="mt-3 max-w-[145px]">
        <h3 class="font-bold text-primary text-xs leading-none">FILTROS</h3>
        <p class="mt-2 max-w-[145px] text-[0.66rem] leading-snug">Acota las mediciones visibles filtrando por escala e instrumento</p>
      </div>
      <fieldset class="mt-4 border-t border-[#5a575a] pt-3">
        <legend class="flex w-full items-center gap-2 text-xs font-medium leading-tight text-foreground"
          ><span>✦ &nbsp;Escala de Bortle</span><button
            type="button"
            class="inline-flex size-4 items-center justify-center rounded-full border border-surface text-[0.58rem] font-medium leading-none text-foreground"
            aria-label="Información sobre la escala de Bortle"
            title="Escala de cielo oscuro de 1 a 9">?</button
          ></legend
        >
        <div class="mt-2 grid grid-cols-3 gap-x-[0.38rem] gap-y-[0.42rem]">
          {
            bortleClasses.toReversed().map((item) => (
              <button
                data-bortle-filter={item.level}
                type="button"
                class="filter-option min-w-0 rounded-[0.2rem] border-0 bg-primary py-0 text-xs font-semibold leading-none text-background h-5"
                aria-pressed="true"
              >
                ✦&nbsp; {item.label}
              </button>
            ))
          }
        </div>
        <p class="mt-3 text-[0.52rem] leading-snug">1: cielo excelente (más oscuro)<br />9: cielo muy afectado (más brillante)</p>
      </fieldset>
      <fieldset class="mt-4 border-t border-[#5a575a] pt-3">
        <legend class="flex w-full items-center gap-2 text-xs font-medium leading-tight text-foreground"
          ><span>✦ &nbsp;Instrumentos</span><button
            type="button"
            class="inline-flex size-4 items-center justify-center rounded-full border border-surface text-[0.58rem] font-medium leading-none text-foreground"
            aria-label="Información sobre los instrumentos"
            title="Tipos de instrumentos de medición">?</button
          ></legend
        >
        <div data-type-filters class="mt-2 flex flex-col gap-2"></div>
      </fieldset>
      <button data-select-all type="button" class="mt-4 flex min-h-8 items-center justify-center gap-2 rounded border border-surface px-3 text-xs font-semibold leading-none text-foreground"
        >Seleccionar todo</button
      >
      <a
        href="#"
        class="rail-button mt-4 flex min-h-8 items-center justify-between gap-2 rounded border border-primary px-4 text-xs font-semibold leading-none text-primary">Tabla de datos <span>→</span></a
      >
    </aside>

    <div class="relative min-w-0 flex-1 overflow-hidden rounded-xl border border-border bg-background">
      <div id="map" class="size-full"></div>
      <button
        data-filter-open
        type="button"
        class="absolute top-3 left-3 z-10 rounded-full bg-foreground px-4 py-2 text-sm font-bold text-background shadow-lg md:hidden"
        aria-expanded="false">Filtros</button
      >
    </div>

    <aside id="instrument-drawer" data-detail-panel aria-hidden="true" class="detail-panel map-panel w-[220px] shrink-0 flex-col overflow-y-auto bg-transparent p-0 pt-8 pl-4">
      <div class="border-b border-[#5a575a] pb-4">
        <h3 data-drawer-title class="font-heading text-base font-bold leading-tight"></h3>
        <p data-drawer-location class="mt-3 text-xs leading-relaxed"></p>
      </div>
      <dl class="grid gap-2 border-b border-[#5a575a] py-4">
        <div><dt class="text-xs font-semibold leading-tight text-foreground">Altitud</dt><dd data-drawer-altitude class="mt-0.5 text-xs leading-relaxed"></dd></div>
        <div><dt class="text-xs font-semibold leading-tight text-foreground">Clima</dt><dd data-drawer-weather class="mt-0.5 text-xs leading-relaxed"></dd></div>
        <div>
          <dt class="text-xs font-semibold leading-tight text-foreground">Equipo y mediciones</dt><dd data-drawer-equipment class="mt-0.5 text-xs leading-relaxed"
          ></dd>
        </div>
      </dl>
      <div data-drawer-bortle class="flex min-h-28 items-center border-b border-[#5a575a] py-3 text-[0.62rem] leading-relaxed"></div>
      <div class="mt-auto pb-8">
        <a data-drawer-link href="#" class="rail-button flex min-h-8 w-full items-center justify-center gap-2 rounded border border-primary px-3 text-xs font-semibold leading-none text-primary"
          >Más información <span>→</span></a
        >
        <button data-drawer-close type="button" class="rail-button mt-4 flex min-h-8 w-full items-center justify-center gap-2 rounded border border-surface px-3 text-xs font-semibold leading-none text-foreground"
          >Cerrar</button
        >
      </div>
    </aside>
  </div>
</section>

<style>
  @reference '../../styles/global.css';

  .detail-panel {
    display: none;
  }
  .detail-panel[data-open] {
    display: flex;
    flex-direction: column;
  }
  [data-map-workspace] > div {
    @apply border border-primary rounded-xl;
  }
  .filter-option[aria-pressed='false'] {
    @apply bg-[#33271a] text-[#9b8365];
  }
  .instrument-options :global(button) {
    @apply h-6 w-full rounded-[0.2rem] border-0 bg-primary text-xs font-semibold leading-none text-background;
  }
  .instrument-options :global(button)::before {
    content: '✦  ';
  }
  .instrument-options :global(button[aria-pressed='false']) {
    @apply bg-[#33271a] text-[#9b8365];
  }
  .drawer-bortle :global(span:first-child) {
    @apply size-auto flex-none bg-transparent font-heading text-[3.8rem] font-bold leading-none text-foreground;
  }
  @media (max-width: 767px) {
    .map-panel {
      @apply absolute inset-0 z-20 w-full bg-black p-5 transition-transform duration-200 ease-in-out;
    }
    .filter-panel {
      @apply -translate-x-full;
    }
    .detail-panel {
      @apply flex translate-x-full flex-col;
    }
    .map-panel[data-open] {
      @apply translate-x-0;
    }
    [data-map-workspace][data-panel-open] [data-filter-open],
    [data-map-workspace][data-panel-open] :global(.maplibregl-ctrl) {
      @apply hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-panel {
      @apply transition-none;
    }
  }
</style>

<script>
  import { bortleClasses } from '@shared/features/bortle'
  import { loadInstruments } from '@shared/features/instruments'
  import { createInstrumentDrawer } from './drawer'
  import { filterByBortle, filterByType } from './filters'
  import { renderPin } from './pin-view'
  import { createMaplibreView } from './providers/maplibre'

  const workspace = document.querySelector<HTMLElement>('[data-map-workspace]')
  const mapEl = document.getElementById('map')
  const filterPanel = document.querySelector<HTMLElement>('[data-filter-panel]')
  const drawerEl = document.getElementById('instrument-drawer')
  const filterOpen = document.querySelector<HTMLButtonElement>('[data-filter-open]')
  if (!workspace || !mapEl || !filterPanel || !drawerEl || !filterOpen) throw new Error('Map section is incomplete')

  const instruments = loadInstruments()
  const types = [...new Set(instruments.map(({ type }) => type))].sort()
  const selectedTypes = new Set(types)
  const selectedLevels = new Set<number>(bortleClasses.map(({ level }) => level))
  let selectedId: string | null = null
  let filterReturnFocus: HTMLElement | undefined
  const view = await createMaplibreView({ container: mapEl, center: { lat: -30.02, lng: -71.27 }, zoom: 9 })

  const syncWorkspace = (): void => {
    workspace.toggleAttribute(
      'data-panel-open',
      filterPanel.hasAttribute('data-open') || drawerEl.hasAttribute('data-open')
    )
    requestAnimationFrame(() => view.resize())
    window.setTimeout(() => view.resize(), 210)
  }
  const drawer = createInstrumentDrawer(drawerEl, (open) => {
    syncWorkspace()
    if (!open && selectedId) {
      selectedId = null
      refresh()
    }
  })
  const closeFilters = (restore = true): void => {
    filterPanel.removeAttribute('data-open')
    filterPanel.setAttribute('aria-hidden', String(matchMedia('(max-width: 767px)').matches))
    filterOpen.setAttribute('aria-expanded', 'false')
    syncWorkspace()
    if (restore) filterReturnFocus?.focus()
  }
  filterOpen.addEventListener('click', () => {
    drawer.close({ restoreFocus: false })
    filterReturnFocus = filterOpen
    filterPanel.setAttribute('data-open', '')
    filterPanel.setAttribute('aria-hidden', 'false')
    filterOpen.setAttribute('aria-expanded', 'true')
    syncWorkspace()
    filterPanel.querySelector<HTMLButtonElement>('[data-filter-close]')?.focus()
  })
  document.querySelector<HTMLButtonElement>('[data-filter-close]')?.addEventListener('click', () => closeFilters())

  const typeRoot = document.querySelector<HTMLElement>('[data-type-filters]')!
  const makeFilter = (label: string, active: () => boolean, toggle: () => void): HTMLButtonElement => {
    const button = document.createElement('button')
    button.type = 'button'
    button.textContent = label
    button.className = 'filter-option'
    const sync = () => button.setAttribute('aria-pressed', String(active()))
    button.addEventListener('click', () => {
      toggle()
      sync()
      refresh()
    })
    sync()
    return button
  }
  typeRoot.replaceChildren(
    ...types.map((type) =>
      makeFilter(
        type,
        () => selectedTypes.has(type),
        () => (selectedTypes.has(type) ? selectedTypes.delete(type) : selectedTypes.add(type))
      )
    )
  )
  document.querySelectorAll<HTMLButtonElement>('[data-bortle-filter]').forEach((button) => {
    const level = Number(button.dataset.bortleFilter)
    button.addEventListener('click', () => {
      selectedLevels.has(level) ? selectedLevels.delete(level) : selectedLevels.add(level)
      button.setAttribute('aria-pressed', String(selectedLevels.has(level)))
      refresh()
    })
  })
  document.querySelector<HTMLButtonElement>('[data-select-all]')?.addEventListener('click', () => {
    types.forEach((type) => selectedTypes.add(type))
    bortleClasses.forEach(({ level }) => selectedLevels.add(level))
    typeRoot.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', 'true'))
    document.querySelectorAll('[data-bortle-filter]').forEach((button) => button.setAttribute('aria-pressed', 'true'))
    refresh()
  })

  function refresh(): void {
    const filtered = filterByBortle(filterByType(instruments, selectedTypes), selectedLevels)
    if (selectedId && !filtered.some(({ id }) => id === selectedId)) {
      selectedId = null
      drawer.close({ restoreFocus: false })
    }
    view.setPins(filtered, (instrument) => renderPin(instrument, instrument.id === selectedId))
    requestAnimationFrame(() => {
      mapEl!.querySelectorAll<HTMLElement>('[data-instrument-id]').forEach((pin) => {
        const instrument = filtered.find(({ id }) => id === pin.dataset.instrumentId)
        if (instrument) {
          const open = () => openInstrument(instrument, pin)
          pin.onpointerup = open
          pin.onmouseup = open
          pin.onclick = open
        }
      })
    })
    const count = filtered.length
    const subtitle = document.querySelector<HTMLElement>('[data-map-header] p:last-child')
    if (subtitle) subtitle.textContent = `${count} ${count === 1 ? 'punto disponible' : 'puntos disponibles'}`
  }
  function openInstrument(instrument: (typeof instruments)[number], pin: HTMLElement): void {
    if (filterPanel?.hasAttribute('data-open')) return
    selectedId = instrument.id
    drawer.open(instrument, pin)
    const bortle = bortleClasses.find(({ level }) => level === instrument.bortleLevel)
    if (bortle) {
      pin.style.backgroundColor = bortle.color
      pin.style.color = bortle.textTone === 'dark' ? '#111114' : '#f5f0f2'
      pin.setAttribute('aria-pressed', 'true')
    }
  }
  const onKeyDown = (event: KeyboardEvent): void => {
    if (event.key === 'Escape' && filterPanel.hasAttribute('data-open')) closeFilters()
  }
  document.addEventListener('keydown', onKeyDown)
  const cleanup = (): void => {
    document.removeEventListener('keydown', onKeyDown)
    drawer.destroy()
    view.destroy()
  }
  window.addEventListener('pagehide', cleanup, { once: true })
  refresh()
</script>
