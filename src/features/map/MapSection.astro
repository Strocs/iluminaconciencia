---
import { bortleClasses } from '@shared/features/bortle'
---

<section id="nodos" class="relative z-10 h-full min-h-[90dvh] w-full p-4 sm:p-6">
  <div class="mx-auto h-full">
    <!-- <h2 class="font-heading text-3xl text-foreground">Nodos de medición</h2> -->
    <!-- <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-text"> -->
    <!--   Red de monitoreo de la contaminación lumínica en la Región de Coquimbo. Filtra los puntos por tipo de instrumento -->
    <!--   o por escala Bortle, y selecciona un nodo para ver su detalle. -->
    <!-- </p> -->

    <div data-map-container class="relative h-[90vh] overflow-hidden rounded-2xl border border-border bg-background">
      <div id="map" class="size-full overflow-hidden"></div>

      <div class="pointer-events-none absolute inset-x-4 top-4 flex flex-wrap gap-3">
        <fieldset
          data-type-filters
          class="pointer-events-auto rounded-xl border border-border bg-background/80 p-3 backdrop-blur"
        >
          <legend class="px-1 text-xs font-medium text-text">Tipo de instrumento</legend>
          <div data-type-chips class="mt-2 flex flex-wrap gap-2"></div>
        </fieldset>
      </div>

      <div class="pointer-events-none absolute inset-x-4 bottom-0">
        <section
          data-map-bortle-filter
          aria-label="Escala de Bortle"
          class="pointer-events-auto mx-auto flex w-full max-w-5xl flex-col gap-2 px-0 pb-6 font-body sm:px-4 [@media(max-height:34rem)]:gap-1 [@media(max-height:34rem)]:pb-3"
        >
          <div
            class="mx-auto flex items-center gap-2 font-mono text-xs tracking-wider text-text uppercase [@media(max-height:34rem)]:text-[10px]"
          >
            <span class="font-semibold">Escala de Bortle</span>
          </div>
          <ol class="mx-auto grid w-full max-w-5xl grid-cols-3 overflow-hidden rounded-full sm:grid-cols-9">
            {
              bortleClasses.map((bortleClass, index) => (
                <li
                  class:list={[
                    'group relative flex min-w-0 items-center justify-between gap-2 p-2 text-xs opacity-40 grayscale transition-all duration-200 select-none data-[active]:z-10 data-[active]:opacity-100 data-[active]:grayscale-0 motion-reduce:transition-none [@media(max-height:34rem)]:p-1.5',
                    index === 0 ? 'pl-4' : '',
                    index === bortleClasses.length - 1 ? 'pr-4' : '',
                    bortleClass.textTone === 'dark' ? 'text-background' : 'text-foreground'
                  ]}
                  data-map-bortle-class={bortleClass.level}
                  aria-label={`Bortle ${bortleClass.level}: ${bortleClass.name}`}
                  title={bortleClass.name}
                  style={`background-color: ${bortleClass.color}`}
                >
                  <span class="mb-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-foreground text-xs font-bold text-background transition-all duration-150 group-data-[active]:scale-110 group-data-[active]:ring group-data-[active]:ring-background">
                    {bortleClass.label}
                  </span>
                  <span class="min-w-0 break-words text-right text-[11px] leading-tight font-bold">{bortleClass.shortName}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside
        id="instrument-drawer"
        class="absolute inset-y-0 right-0 z-10 flex h-full w-full max-w-sm translate-x-full flex-col overflow-y-auto border-l border-border bg-background p-5 shadow-2xl transition-transform duration-300"
        aria-hidden="true"
      >
        <header class="sticky top-0 flex shrink-0 items-start justify-between gap-4 bg-background pb-2">
          <h3 data-drawer-title class="font-heading text-xl leading-snug text-foreground"></h3>
          <button
            data-drawer-close
            type="button"
            class="rounded-full border border-border px-2.5 py-1 text-text transition-colors hover:text-foreground"
            aria-label="Cerrar panel"
          >
            ✕
          </button>
        </header>
        <dl data-drawer-rows class="mt-5 space-y-3"></dl>
        <a
          data-drawer-link
          href="#"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-full bg-primary px-5 py-2 text-sm font-semibold text-background transition-opacity hover:opacity-90"
        >
          Más información
        </a>
      </aside>
    </div>
  </div>
</section>

<script>
  import { loadInstruments } from '@shared/features/instruments'
  import { bortleClasses } from '@shared/features/bortle'
  import { createBortleFilter } from './bortle-filter'
  import { createInstrumentDrawer } from './drawer'
  import { filterByBortle, filterByType } from './filters'
  import { renderPin } from './pin-view'
  import { createMaplibreView } from './providers/maplibre'

  const mapEl = document.getElementById('map')
  const drawerEl = document.getElementById('instrument-drawer')
  if (!mapEl || !drawerEl) throw new Error('Map section is missing a required element')

  const instruments = loadInstruments()
  const drawer = createInstrumentDrawer(drawerEl)

  // Filter options derive from the data itself, so new instrument types
  // or Bortle levels appear automatically — the contract stays open.
  const types = [...new Set(instruments.map((instrument) => instrument.type))].sort()
  const selectedTypes = new Set(types)

  function chipClass(active: boolean): string {
    return active
      ? 'rounded-full bg-primary px-3 py-1 text-xs font-semibold text-background'
      : 'rounded-full border border-border bg-background px-3 py-1 text-xs text-text transition-colors hover:text-foreground'
  }

  function renderTypeChips(
    container: HTMLElement,
    values: readonly string[],
    selected: Set<string>,
    onToggle: (value: string) => void
  ): void {
    container.replaceChildren(
      ...values.map((value) => {
        const chip = document.createElement('button')
        chip.type = 'button'
        chip.textContent = String(value)
        chip.className = chipClass(selected.has(value))
        chip.setAttribute('aria-pressed', String(selected.has(value)))
        chip.addEventListener('click', () => {
          onToggle(value)
          chip.className = chipClass(selected.has(value))
          chip.setAttribute('aria-pressed', String(selected.has(value)))
        })
        return chip
      })
    )
  }

  let selectedLevels: ReadonlySet<number> = new Set(bortleClasses.map(({ level }) => level))

  renderTypeChips(document.querySelector<HTMLElement>('[data-type-chips]')!, types, selectedTypes, (type) => {
    if (selectedTypes.has(type)) selectedTypes.delete(type)
    else selectedTypes.add(type)
    refresh()
  })

  const bortleFilterRoot = document.querySelector<HTMLElement>('[data-map-bortle-filter]')
  if (!bortleFilterRoot) throw new Error('Map section is missing its Bortle filter')

  const bortleFilter = createBortleFilter({
    root: bortleFilterRoot,
    classes: bortleClasses,
    onToggle: (selected) => {
      selectedLevels = new Set(selected)
      refresh()
    }
  })

  // MapLibre GL JS (~900 KB) is loaded dynamically so it splits into a separate
  // chunk instead of blocking the initial bundle. Pins are attached once the
  // view is ready; filters update the already-created view.
  const view = await createMaplibreView({ container: mapEl })
  view.onPinClick((instrument) => drawer.open(instrument))
  window.addEventListener(
    'pagehide',
    () => {
      bortleFilter.destroy()
      view.destroy()
    },
    { once: true }
  )

  function refresh(): void {
    const filtered = filterByBortle(filterByType(instruments, selectedTypes), selectedLevels)
    view.setPins(filtered, renderPin)
  }
  refresh()
</script>
