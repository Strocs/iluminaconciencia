---
import LinkButton from '@shared/components/ui/LinkButton.astro'
---

<aside
  id="instrument-drawer"
  data-detail-panel
  aria-hidden="true"
  class="detail-panel map-panel flex min-h-0 w-0 shrink-0 translate-x-2 flex-col self-stretch bg-transparent p-0 pt-0 pl-0 opacity-0 transition-[width,padding,transform,opacity] duration-200 ease-in-out data-open:w-[220px] data-open:translate-x-0 data-open:pt-8 data-open:pl-4 data-open:opacity-100 motion-reduce:transition-none max-md:absolute max-md:inset-0 max-md:z-20 max-md:flex max-md:w-full max-md:translate-x-full max-md:bg-background max-md:p-5 max-md:transition-transform max-md:duration-200 max-md:ease-in-out max-md:data-open:translate-x-0"
>
  <div class="border-b border-border pb-4">
    <h3 data-drawer-title class="font-body text-base leading-tight font-bold text-primary"></h3>
  </div>
  <dl class="grid gap-3 border-b border-border py-4 text-sm/relaxed">
    <div data-drawer-weather-row>
      <dt class="text-sm/relaxed font-semibold text-foreground">Clima</dt><dd data-drawer-weather></dd>
    </div>
    <div>
      <dt class="text-sm/relaxed font-semibold text-foreground">Equipo y mediciones</dt><dd data-drawer-equipment></dd>
    </div>
    <div data-drawer-summary-row hidden>
      <dt class="text-sm/relaxed font-semibold text-foreground">Resumen</dt><dd data-drawer-summary></dd>
    </div>
  </dl>
  <div data-drawer-bortle hidden class="min-h-28 border-b border-border py-3 text-sm/relaxed">
    <div class="flex items-center gap-3">
      <span data-bortle-label class="rotate-180 text-xs font-semibold text-foreground [writing-mode:vertical-rl]"
        >Nivel de Bortle</span
      >
      <div data-bortle-scale class="flex flex-col items-center justify-center gap-1">
        <span data-bortle-level class="font-body text-6xl leading-none font-bold text-foreground"></span>
        <span data-bortle-marker class="size-3 shrink-0 rounded-full" aria-hidden="true"></span>
      </div>
      <div class="min-w-0">
        <p data-bortle-classification class="font-semibold text-foreground"></p>
        <p class="text-muted-foreground mt-1 text-xs leading-relaxed">SQM <span data-bortle-sqm></span> mag/arcsec²</p>
      </div>
    </div>
  </div>
  <div class="mt-auto space-y-4">
    <LinkButton data-drawer-link href="/" size="sm" class="w-full h-8 rounded-sm border border-primary bg-transparent py-1 text-primary hover:bg-transparent">Más información</LinkButton>
    <LinkButton data-drawer-close as="btn" size="sm" class="w-full h-8 rounded-sm border border-foreground bg-transparent py-1 text-foreground hover:bg-transparent">Cerrar</LinkButton>
  </div>
</aside>
