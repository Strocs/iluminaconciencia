---
import Button from '@shared/components/ui/Button.astro'
import InfoPopover from '@shared/components/ui/InfoPopover.astro'
import LinkButton from '@shared/components/ui/LinkButton.astro'
import { bortleClasses } from '@shared/features/bortle'
---

<aside
  data-filter-panel
  aria-label="Filtros del mapa"
  aria-hidden="false"
  class="map-panel flex min-h-0 w-48 shrink-0 flex-col self-stretch overflow-y-auto bg-transparent p-0 pt-8 motion-reduce:transition-none max-md:absolute max-md:inset-0 max-md:z-20 max-md:w-full max-md:-translate-x-full max-md:bg-background max-md:p-5 max-md:transition-transform max-md:duration-200 max-md:ease-in-out max-md:data-open:translate-x-0"
>
  <div class="flex items-center justify-between md:hidden">
    <h3 class="font-heading text-xl font-bold">Filtros</h3>
    <Button data-filter-close size="sm" aria-label="Cerrar filtros">Cerrar</Button>
  </div>
  <div class="mt-3 max-w-44">
    <h3 class="text-base leading-none font-bold text-primary">FILTROS</h3>
    <p class="mt-2 max-w-44 text-sm leading-snug text-text">
      Acota las mediciones visibles filtrando por escala e instrumento
    </p>
  </div>
  <fieldset class="mt-4 border-t border-border pt-3">
    <legend class="flex w-full items-center gap-2 text-sm leading-tight font-medium text-foreground">
      <span>✦ &nbsp;Escala de Bortle</span>
      <InfoPopover label="Información sobre la escala de Bortle" placement="bottom-right" size="sm">
        <p>Filtra las mediciones por nivel de oscuridad del cielo, del 1 (más oscuro) al 9 (más brillante).</p>
      </InfoPopover>
    </legend>
    <div class="mt-2 grid grid-cols-3 gap-2">
      {
        bortleClasses.toReversed().map((item) => (
          <button
            data-bortle-filter={item.level}
            type="button"
            class="filter-option h-8 min-w-0 rounded border border-primary bg-primary px-1 py-0 text-sm leading-none font-semibold text-background transition-colors outline-none hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-95 aria-[pressed=false]:border-border aria-[pressed=false]:bg-background aria-[pressed=false]:text-text aria-[pressed=false]:hover:border-primary aria-[pressed=false]:hover:text-primary motion-reduce:transition-none motion-reduce:active:scale-100"
            aria-pressed="true"
          >
            ✦&nbsp; {item.label}
          </button>
        ))
      }
    </div>
    <p class="mt-3 text-xs leading-normal text-text">
      1: cielo excelente (más oscuro)<br />9: cielo muy afectado (más brillante)
    </p>
  </fieldset>
  <fieldset class="mt-4 border-t border-border pt-3">
    <legend class="flex w-full items-center gap-2 text-sm leading-tight font-medium text-foreground">
      <span>✦ &nbsp;Instrumentos</span>
      <InfoPopover label="Información sobre los instrumentos" placement="bottom-right" size="sm">
        <p>Filtra las mediciones según el instrumento con el que se registró el brillo del cielo.</p>
      </InfoPopover>
    </legend>
    <div data-type-filters class="mt-2 flex flex-col gap-2"></div>
  </fieldset>
  <Button data-select-all size="sm" class="mt-4 w-full">Seleccionar todo</Button>
  <LinkButton
    href="#"
    variant="important"
    disabled
    size="sm"
    class="mt-4 w-full"
    aria-label="Tabla de datos no disponible">Tabla de datos</LinkButton
  >
</aside>
