---
import Header from '@shared/components/ui/Header.astro'
import LinkButton from '@shared/components/ui/LinkButton.astro'

import { articleItems, newsItems } from './news.mock'

const rowClasses =
  'group relative flex min-h-37 items-center gap-4 border-b border-foreground/18 py-4 pr-10 first:pt-0 max-sm:min-h-0 max-sm:items-start max-sm:py-5'
const imageClasses =
  'size-full max-w-50 object-cover transition-transform duration-200 ease-out group-hover:scale-[1.035] motion-reduce:transition-none motion-reduce:group-hover:scale-100'
const titleClasses =
  'mt-2 text-balance font-heading text-[clamp(1.25rem,1.8vw,1.55rem)] leading-[0.98] text-foreground'
const titleLinkClasses =
  'rounded-xs outline-none transition-colors duration-150 group-hover:text-primary focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none'
const arrowClasses =
  'absolute right-0.5 grid size-8 place-items-center rounded-full text-primary outline-none transition-[transform,color] duration-200 ease-out group-hover:-rotate-45 group-hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background max-sm:right-0 max-sm:bottom-5 motion-reduce:transition-none motion-reduce:group-hover:rotate-0'
---

<section class="news-articles relative z-10 px-4 py-16 sm:px-5 sm:py-20 lg:py-28" aria-label="Noticias y artículos">
  <div class="mx-auto grid w-full max-w-[90rem] gap-20 lg:grid-cols-2 lg:gap-24">
    <section id="noticias" class="scroll-mt-28" aria-labelledby="noticias-title">
      <Header titleId="noticias-title" class="py-0" eyebrow="03 / NOTICIAS" title="Noticias Recientes" />

      <div class="mt-12 lg:mt-16">
        {
          newsItems.map((item) => (
            <article class:list={['news-row max-sm:flex-col', rowClasses]}>
              <div class="card-image-frame aspect-5/3 w-48 shrink-0 overflow-hidden rounded-xs border border-border max-sm:w-full">
                <img
                  class:list={['card-image', imageClasses]}
                  src={item.image}
                  alt={item.imageAlt}
                  width="370"
                  height="240"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="min-w-0 flex-1">
                <p class="item-meta text-[0.67rem] text-primary">{item.date}</p>
                <h3 class={titleClasses}>
                  <a class={titleLinkClasses} href={item.href} target="_blank" rel="noreferrer">
                    {item.title}
                  </a>
                </h3>
                <p class="item-description mt-2.5 text-pretty text-xs/4 text-text">{item.description}</p>
              </div>
              <a class:list={['arrow-link', arrowClasses]} href={item.href} target="_blank" rel="noreferrer" aria-label={`Leer ${item.title}`}>
                <svg class="size-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.75]" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 12h8m-4-4 4 4-4 4" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <LinkButton
          href="https://iluminaconciencia.userena.digital/#news"
          target="_blank"
          rel="noreferrer"
          variant="important">Más Noticias</LinkButton
        >
      </div>
    </section>

    <section id="articulos" class="scroll-mt-28" aria-labelledby="articulos-title">
      <Header titleId="articulos-title" class="py-0" eyebrow="04 / ARTÍCULOS" title="Artículos y Publicaciones" />

      <div class="mt-12 lg:mt-16">
        {
          articleItems.map((item) => (
            <article class:list={['article-row', rowClasses, { 'article-row--featured max-sm:flex-col': item.image }]}>
              {item.image && (
                <div class="card-image-frame aspect-square w-29 shrink-0 overflow-hidden rounded-xs border border-border max-sm:w-24">
                  <img
                    class:list={['card-image', imageClasses]}
                    src={item.image}
                    alt={item.imageAlt ?? ''}
                    width="240"
                    height="240"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <>
                    <p class="item-meta text-[0.67rem] text-primary">{item.date}</p>
                    <span class="text-primary" aria-hidden="true">✦</span>
                    <span class="category rounded bg-foreground/55 px-2 py-0.5 text-[0.62rem] text-background">{item.category}</span>
                  </>
                </div>
                <h3 class={titleClasses}>
                  <a class={titleLinkClasses} href={item.href} target="_blank" rel="noreferrer">
                    {item.title}
                  </a>
                </h3>
                <p class="item-description mt-2.5 text-pretty text-xs/4 text-text">{item.description}</p>
              </div>
              <a class:list={['arrow-link', arrowClasses]} href={item.href} target="_blank" rel="noreferrer" aria-label={`Leer ${item.title}`}>
                <svg class="size-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.75]" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 12h8m-4-4 4 4-4 4" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <LinkButton
          href="https://iluminaconciencia.userena.digital/#articles"
          target="_blank"
          rel="noreferrer"
          variant="important">Más Artículos</LinkButton
        >
      </div>
    </section>
  </div>
</section>
